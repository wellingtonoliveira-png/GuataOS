class Central(Adw.Application):
    def __init__(self): super().__init__(application_id="br.com.guataos.Central")

    def do_activate(self):
        css=Gtk.CssProvider(); css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, 1000)
        self.nome=primeiro_nome(); self.tiles=[]
        win=Adw.ApplicationWindow(application=self); win.set_title("GUATÁ Central"); win.set_default_size(1000,760)
        win.add_css_class("janela")
        tv=Adw.ToolbarView(); hb=Adw.HeaderBar(); hb.set_show_end_title_buttons(True)
        tl=Gtk.Label(label="GUATÁ Central"); tl.add_css_class("title"); hb.set_title_widget(tl)
        lf=os.path.join(ICON,"guata-icone-48.png")
        if os.path.exists(lf): i=Gtk.Image.new_from_file(lf); i.set_pixel_size(24); hb.pack_start(i)
        tv.add_top_bar(hb); win.set_content(tv)
        sc=Gtk.ScrolledWindow(hexpand=True,vexpand=True); tv.set_content(sc)
        root=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_top=18, margin_start=26, margin_end=26, margin_bottom=22)
        sc.set_child(root)

        # header
        head=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18, margin_bottom=6)
        cap=os.path.join(ICON,"mascote-acenando.png")
        if os.path.exists(cap): im=Gtk.Image.new_from_file(cap); im.set_pixel_size(84); head.append(im)
        hv=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        ola=Gtk.Label(xalign=0); ola.add_css_class("ola"); ola.set_markup(f'Tudo em um lugar, <span foreground="#2f8f66">{self.nome}</span>.')
        sub=Gtk.Label(label="Trabalho, cuidado com o computador e a natureza do Brasil — num painel só.", xalign=0); sub.add_css_class("sub"); sub.set_wrap(True)
        hv.append(ola); hv.append(sub); head.append(hv)
        root.append(head)

        # busca (filtra tiles)
        self.busca=Gtk.SearchEntry(); self.busca.add_css_class("busca"); self.busca.set_placeholder_text("Pesquisar apps, impressoras, ajuda…")
        self.busca.connect("search-changed", self._filtrar); self.busca.set_margin_top(10); self.busca.set_margin_bottom(6)
        root.append(self.busca)

        # status strip
        self.strip=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12, homogeneous=True, margin_top=6, margin_bottom=4)
        self.c_en=self._stcard("ENERGIA","…","")
        self.c_seg=self._stcard("SEGURANÇA","…","")
        self.c_up=self._stcard("ATUALIZAÇÕES","…","")
        self.c_sau=self._stcard("SAÚDE DO PC","…","")
        for c in (self.c_en,self.c_seg,self.c_up,self.c_sau): self.strip.append(c["box"])
        root.append(self.strip)
        threading.Thread(target=self._status_bg, daemon=True).start()

        # seções
        for titulo, cnt, nat, mods in SECOES:
            h=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, margin_top=18, margin_bottom=8)
            lb=Gtk.Label(label=titulo, xalign=0); lb.add_css_class("h2"); h.append(lb)
            if cnt: cl=Gtk.Label(label=cnt); cl.add_css_class("cnt"); cl.set_valign(Gtk.Align.CENTER); h.append(cl)
            root.append(h)
            fb=Gtk.FlowBox(); fb.set_selection_mode(Gtk.SelectionMode.NONE); fb.set_max_children_per_line(6); fb.set_column_spacing(12); fb.set_row_spacing(12); fb.set_homogeneous(True)
            for emoji,nome,desc,acao in mods:
                fb.append(self._tile(emoji,nome,desc,acao,nat))
            root.append(fb)

        # assistente
        ass=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14, margin_top=20); ass.add_css_class("ass")
        cp=os.path.join(ICON,"mascote-acenando.png")
        if os.path.exists(cp): a=Gtk.Image.new_from_file(cp); a.set_pixel_size(46); ass.append(a)
        msg=Gtk.Label(xalign=0); msg.add_css_class("msg"); msg.set_wrap(True)
        msg.set_markup('<b>Tudo certo por aqui. 🌱</b>  <span foreground="#7f8c7e">Quando houver atualização grande, eu aviso com jeitinho.</span>')
        ass.append(msg); root.append(ass)
        win.present()

    def _stcard(self, l, v, d):
        box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2); box.add_css_class("st")
        ll=Gtk.Label(label=l, xalign=0); ll.add_css_class("l")
        vv=Gtk.Label(label=v, xalign=0); vv.add_css_class("v")
        dd=Gtk.Label(label=d, xalign=0); dd.add_css_class("d"); dd.set_wrap(True)
        box.append(ll); box.append(vv); box.append(dd)
        return {"box":box,"v":vv,"d":dd}

    def _tile(self, emoji, nome, desc, acao, nat):
        b=Gtk.Button(); b.add_css_class("tile")
        if nat: b.add_css_class("nat")
        b.connect("clicked", self._abrir, acao, nome)
        bx=Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        cmd=(acao[0] if isinstance(acao,(list,tuple)) and acao and isinstance(acao[0],str) and acao[0] not in ("web","settings") else None)
        icf=os.path.join(ICON, CMD2ICON.get(cmd,"")) if cmd else ""
        if icf and os.path.exists(icf):
            e=Gtk.Image.new_from_file(icf); e.set_pixel_size(50); e.add_css_class("icimg")
        else:
            e=Gtk.Label(label=emoji, xalign=0); e.add_css_class("ic")
        n=Gtk.Label(label=nome, xalign=0); n.add_css_class("n")
        d=Gtk.Label(label=desc, xalign=0); d.add_css_class("d"); d.set_wrap(True)
        bx.append(e); bx.append(n); bx.append(d); b.set_child(bx)
        self.tiles.append((b, (nome+" "+desc).lower()))
        return b

    def _filtrar(self, entry):
        q=entry.get_text().strip().lower()
        for b,txt in self.tiles:
            b.get_parent().set_visible(q in txt if q else True)

    def _abrir(self, _btn, acao, nome):
        if acao is None:
            self._dlg(f"{nome} — em breve 🌱", "Esse módulo faz parte do roadmap do Guatá e chega nas próximas versões."); return
        if isinstance(acao, tuple) and acao[0]=="web":
            self._run(["xdg-open", acao[1]]); return
        if not self._run(acao):
            self._dlg(f"{nome}", "Não consegui abrir agora. Talvez o app ainda não esteja instalado.")

    def _run(self, cmd):
        try: subprocess.Popen(cmd); return True
        except Exception: return False

    def _dlg(self, h, b):
        d=Adw.MessageDialog(transient_for=self.get_active_window(), heading=h, body=b)
        d.add_response("ok","Entendi"); d.present()

    # ---- status (async) ----
    def _status_bg(self):
        # energia
        en="—"; end=""
        r=sh(["powerprofilesctl","get"])
        if r and r.returncode==0:
            m={"power-saver":"🍃 Folha","balanced":"🌿 Equilíbrio","performance":"⚡ Potência"}
            en=m.get(r.stdout.strip(), r.stdout.strip())
        rb=sh(["sh","-c","cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1"])
        if rb and rb.stdout.strip(): end=f"bateria {rb.stdout.strip()}%"
        GLib.idle_add(self._set, self.c_en, en, end)
        # segurança / domínio
        seg="Pessoal"; segd="fora de domínio"
        if shutil.which("realm"):
            rr=sh(["realm","list"])
            if rr and rr.stdout.strip():
                seg="Protegido"; segd="no domínio "+rr.stdout.splitlines()[0].strip()
        GLib.idle_add(self._set, self.c_seg, seg, segd)
        # saúde (disco)
        sau="Tudo bem"; saud=""
        rd=sh(["df","--output=pcent","/"])
        if rd and rd.returncode==0:
            try:
                p=rd.stdout.strip().splitlines()[-1].strip()
                saud="disco "+p
                if int(p.replace("%",""))>=90: sau="Atenção"
            except Exception: pass
        GLib.idle_add(self._set, self.c_sau, sau, saud)
        # atualizações
        up="Verificando…"; upd=""
        ru=sh(["apt-get","-s","upgrade"],25)
        if ru:
            n=len([l for l in ru.stdout.splitlines() if l.startswith("Inst ")])
            up = "Tudo atualizado" if n==0 else f"{n} disponível(is)"
            upd = "" if n==0 else "abra Atualizações"
        GLib.idle_add(self._set, self.c_up, up, upd)

    def _set(self, card, v, d):
        card["v"].set_label(v); card["d"].set_label(d); return False

if __name__ == "__main__":
    Central().run(None)
