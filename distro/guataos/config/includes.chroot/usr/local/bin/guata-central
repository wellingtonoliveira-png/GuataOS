#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""GUATÁ Central — o painel único do Guatá OS. Um ícone, tudo num lugar.
Cara Guatá: mascote + natureza + premium. Cada bloco lança um módulo."""
import gi, os, subprocess, shutil, threading, pwd
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, Gdk, GLib

ICON = "/usr/share/icons/guata"

CMD2ICON = {
 "entrar-dominio":"app-dominio.png","kurumim":"kurumim.png","receitas":"app-caderno.png",
 "expedicoes":"app-expedicoes.png","cantinho-gui":"app-cantinho.png",
 "guata-energia":"app-energia.png","guata-reparar":"app-reparar.png","guata-raizes":"app-raizes.png",
 "guata-pausa":"app-pausa.png","guata-brasil":"app-brasil.png","guata-diagnostico":"app-diagnostico.png",
 "guata-atualizacoes":"app-atualizacoes.png","guata-ajustes":"app-ajustes.png","ocara":"ocara.png","guata-ia":"capivara-mascote.png","guata-drivers":"app-ferramentas.png","nidus":"nidus.png",
 "paje":"app-ferramentas.png","guata-wallpapers":"app-wallpapers.png",
}


def primeiro_nome():
    try:
        g = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
        if g: return g.split()[0]
    except Exception: pass
    try: return (os.getlogin() or "amigo").split()[0].capitalize()
    except Exception: return "amigo"

def sh(cmd, t=6):
    try: return subprocess.run(cmd, capture_output=True, text=True, timeout=t)
    except Exception: return None

