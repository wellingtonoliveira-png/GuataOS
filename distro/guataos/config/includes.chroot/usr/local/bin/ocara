#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# Ocara — a loja do guataOS. Curada, bonita, instala em 1 clique (zero comando).
# "Ocara" = o pátio da aldeia, onde a comunidade se encontra.
# Frontend WebKit (cara de loja Guatá, laranja) + motor real (apt/flatpak/IA).
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2, GLib, Gdk, Gio
import subprocess, threading, shutil, os, json, urllib.request, urllib.error

os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "1")
THEME = "/usr/share/ocara-web/index.html"

# ───────────────────────── IA (mesma config do Assistente Guatá) ─────────────
IA_CFG = os.path.expanduser("~/.config/guata/ia.json")
IA_PRESETS = {
    "claude":     {"tipo": "claude", "base": "https://api.anthropic.com/v1",                      "modelo": "claude-sonnet-5"},
    "openai":     {"tipo": "openai", "base": "https://api.openai.com/v1",                          "modelo": "gpt-4o-mini"},
    "gemini":     {"tipo": "openai", "base": "https://generativelanguage.googleapis.com/v1beta/openai", "modelo": "gemini-2.0-flash"},
    "openrouter": {"tipo": "openai", "base": "https://openrouter.ai/api/v1",                       "modelo": "openai/gpt-4o-mini"},
    "groq":       {"tipo": "openai", "base": "https://api.groq.com/openai/v1",                     "modelo": "llama-3.3-70b-versatile"},
    "local":      {"tipo": "openai", "base": "http://localhost:11434/v1",                          "modelo": "llama3.1"},
    "outro":      {"tipo": "openai", "base": "",                                                   "modelo": ""},
}


def ia_perfil():
    try:
        with open(IA_CFG) as f: cfg = json.load(f)
    except Exception:
        cfg = {}
    prov = cfg.get("provedor", "claude")
    preset = IA_PRESETS.get(prov, IA_PRESETS["claude"])
    p = cfg.get("perfis", {}).get(prov, {})
    return {"tipo": preset["tipo"], "base": (p.get("base") or preset["base"]).rstrip("/"),
            "modelo": p.get("modelo") or preset["modelo"], "api_key": p.get("api_key", "")}


def ia_perguntar(perfil, sistema, texto):
    try:
        mdl = perfil["modelo"] if not perfil["modelo"].startswith("gemini-1.5") else "gemini-2.0-flash"
        if perfil["tipo"] == "claude":
            corpo = json.dumps({"model": mdl, "max_tokens": 700, "system": sistema,
                                "messages": [{"role": "user", "content": texto}]}).encode()
            req = urllib.request.Request(perfil["base"] + "/messages", data=corpo, method="POST")
            req.add_header("x-api-key", perfil["api_key"]); req.add_header("anthropic-version", "2023-06-01")
            req.add_header("content-type", "application/json")
            with urllib.request.urlopen(req, timeout=60) as r:
                d = json.loads(r.read().decode())
            return ("".join(b.get("text", "") for b in d.get("content", []) if b.get("type") == "text").strip(), None)
        else:
            msgs = [{"role": "system", "content": sistema}, {"role": "user", "content": texto}]
            corpo = json.dumps({"model": mdl, "max_tokens": 700, "messages": msgs}).encode()
            base = perfil["base"].rstrip("/")
            if "generativelanguage.googleapis.com" in base and not base.endswith("/openai"):
                base = "https://generativelanguage.googleapis.com/v1beta/openai"
            req = urllib.request.Request(base + "/chat/completions", data=corpo, method="POST")
            req.add_header("content-type", "application/json")
            if perfil["api_key"]: req.add_header("Authorization", "Bearer " + perfil["api_key"])
            with urllib.request.urlopen(req, timeout=60) as r:
                d = json.loads(r.read().decode())
            return (d["choices"][0]["message"]["content"].strip(), None)
    except urllib.error.HTTPError as e:
        if e.code in (401, 403): return (None, "Chave de API inválida. Configure no app Assistente Guatá.")
        return (None, "Erro da API (%s)." % e.code)
    except urllib.error.URLError:
        return (None, "Sem conexão com o provedor de IA.")
    except Exception as e:
        return (None, "Falha: %s" % e)


def ia_extrair_json(txt):
    try:
        i = txt.index("{"); j = txt.rindex("}") + 1
        return json.loads(txt[i:j])
    except Exception:
        return None


