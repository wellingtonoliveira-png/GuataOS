def icone_de(nome):
    for k, v in ICON_MAP.items():
        if k in nome:
            return v
    return ("apps", "#6E5F50")


def installed(app):
    m = app.get("metodo")
    if m == "run":
        return bool(shutil.which(app.get("bin", "")))
    if m == "apt":
        if app.get("bin") and shutil.which(app["bin"]):
            return True
        try:
            out = subprocess.run(["dpkg-query", "-W", "-f=${Status}", app["id"]], capture_output=True, text=True, timeout=5)
            return "install ok installed" in out.stdout
        except Exception:
            return False
    if m == "flatpak":
        if not shutil.which("flatpak"):
            return False
        try:
            return subprocess.run(["flatpak", "info", app["id"]], capture_output=True, timeout=8).returncode == 0
        except Exception:
            return False
    if m == "suite":
        for p in app.get("pkgs", "").split():
            try:
                out = subprocess.run(["dpkg-query", "-W", "-f=${Status}", p], capture_output=True, text=True, timeout=5)
                if "install ok installed" not in out.stdout:
                    return False
            except Exception:
                return False
        return bool(app.get("pkgs"))
    if m == "web":
        return True
    return False


def estado_de(app):
    m = app.get("metodo")
    if m == "soon": return "breve"
    if m == "web":  return "abrir"
    if m == "run":  return "abrir" if installed(app) else "instalar"
    return "abrir" if installed(app) else "instalar"


def run_install(app, on_line, on_done):
    m = app["metodo"]
    try:
        if m == "apt":
            if app.get("i386"):
                cmd = ["pkexec", "sh", "-c",
                       "dpkg --add-architecture i386 && apt-get update && "
                       "apt-get install -y " + app["id"]]
            else:
                cmd = ["pkexec", "apt-get", "install", "-y", app["id"]]
        elif m == "flatpak":
            subprocess.run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub",
                            "https://flathub.org/repo/flathub.flatpakrepo"], capture_output=True)
            cmd = ["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", app["id"]]
        elif m == "suite":
            cmd = ["pkexec", "apt-get", "install", "-y"] + app.get("pkgs", "").split()
        else:
            on_done(False); return
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for line in p.stdout:
            on_line(line.rstrip())
        p.wait()
        ok = (p.returncode == 0)
        if ok and m == "suite":
            for pkg in app.get("pkgs", "").split():
                r = subprocess.run(["dpkg-query", "-W", "-f=${Status}", pkg], capture_output=True, text=True)
                if "install ok installed" not in r.stdout:
                    ok = False
        on_done(ok)
    except Exception as e:
        on_line(str(e)); on_done(False)


class Ocara:
    def __init__(self):
        self.win = Gtk.Window()
        self.win.set_default_size(1120, 720)
        self.win.set_title("Ocara — a loja do GuatáOS")
        try: self.win.set_icon_name("ocara")
        except Exception: pass
        ucm = WebKit2.UserContentManager()
        ucm.register_script_message_handler("guata")
        ucm.connect("script-message-received::guata", self.on_msg)
        self.web = WebKit2.WebView.new_with_user_content_manager(ucm)
        self.web.get_settings().set_enable_developer_extras(False)
        self.web.set_background_color(Gdk.RGBA(0.973, 0.980, 0.988, 1))
        self.web.load_uri("file://" + THEME)
        self.win.add(self.web)
        self.win.connect("destroy", Gtk.main_quit)
        self.win.show_all()

    def js(self, code):
        try: self.web.run_javascript(code, None, None, None)
        except Exception as e: print("ocara js:", e)

    # ---- catálogo ----
    def enviar_catalogo(self):
        def bg():
            apps = []
            for i, a in enumerate(APPS):
                ic, cor = icone_de(a["nome"])
                apps.append({"i": i, "nome": a["nome"], "icon": ic, "cor": cor,
                             "desc": a.get("desc", ""), "cat": a["cat"],
                             "feat": bool(a.get("feat")), "estado": estado_de(a)})
            payload = {"cats": CATS, "apps": apps}
            GLib.idle_add(lambda: self.js("window.guataCatalogo && window.guataCatalogo(%s)" % json.dumps(payload, ensure_ascii=False)))
        threading.Thread(target=bg, daemon=True).start()

    # ---- mensagens do HTML ----
    def on_msg(self, ucm, message):
        try:
            data = json.loads(message.get_js_value().to_string())
        except Exception:
            return
        action = data.get("action")
        if action == "pronto":
            self.enviar_catalogo()
        elif action == "install":
            self.instalar(data.get("i"))
        elif action == "open":
            self.abrir(data.get("i"))
        elif action == "ia":
            self.ia(data.get("texto", ""))

    def instalar(self, i):
        try: app = APPS[int(i)]
        except Exception: return

        def line(_l): pass
        def done(ok):
            est = "abrir" if ok else "instalar"
            msg = (app["nome"] + " instalado!") if ok else ("Não deu pra instalar " + app["nome"] + ".")
            GLib.idle_add(lambda: self.js("window.guataEstado && window.guataEstado(%d,%s)" % (i, json.dumps(est))))
            GLib.idle_add(lambda: self.js("window.guataToast && window.guataToast(%s)" % json.dumps(msg)))
        threading.Thread(target=run_install, args=(app, line, done), daemon=True).start()

    def abrir(self, i):
        try: app = APPS[int(i)]
        except Exception: return
        m = app.get("metodo")
        try:
            if app.get("web_url"):
                Gio.AppInfo.launch_default_for_uri(app["web_url"], None)
            elif m == "web":
                Gio.AppInfo.launch_default_for_uri(app["url"], None)
            elif m == "run":
                subprocess.Popen([app["cmd"]])
            elif app.get("bin"):
                subprocess.Popen([app["bin"]])
            elif m == "flatpak":
                subprocess.Popen(["flatpak", "run", app["id"]])
            elif m == "apt" and app.get("id"):
                subprocess.Popen([app["id"]])
        except Exception as e:
            print("ocara abrir:", e)

    def ia(self, texto):
        texto = (texto or "").strip()
        if not texto:
            return
        perfil = ia_perfil()
        if not perfil["api_key"] and "localhost" not in perfil["base"]:
            self.js("window.guataIA && window.guataIA(%s)" % json.dumps(
                {"erro": "Configure a IA primeiro: app Assistente Guatá → engrenagem → provedor + chave."}))
            return

        def bg():
            catalogo = [{"i": i, "nome": a["nome"], "cat": a["cat"], "desc": a.get("desc", "")[:90]}
                        for i, a in enumerate(APPS)]
            sistema = ("Você é o curador da loja Ocara do Guatá OS (Linux brasileiro). "
                       "Dado o pedido e o catálogo em JSON, escolha de 1 a 3 apps que melhor atendem. "
                       "Responda SOMENTE um JSON válido: {\"indices\":[ints], \"resposta\":\"frase curta pt-BR\"}. "
                       "Use só índices que existem. Se nada servir, indices:[].")
            resp, erro = ia_perguntar(perfil, sistema, "Pedido: %s\n\nCatálogo:\n%s"
                                      % (texto, json.dumps(catalogo, ensure_ascii=False)))
            if erro:
                out = {"erro": erro}
            else:
                data = ia_extrair_json(resp or "") or {}
                idx = [i for i in data.get("indices", []) if isinstance(i, int) and 0 <= i < len(APPS)]
                out = {"frase": data.get("resposta", ""), "indices": idx}
            GLib.idle_add(lambda: self.js("window.guataIA && window.guataIA(%s)" % json.dumps(out, ensure_ascii=False)))
        threading.Thread(target=bg, daemon=True).start()


if __name__ == "__main__":
    Ocara()
