#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""O Caderno da Mãe — app nativo (WebKit) das receitas da família. Offline, local.
Backend de busca: procura na internet, lê a receita estruturada (schema.org/Recipe),
baixa a foto e devolve pro app salvar — guardando sempre o link da fonte (crédito)."""
import gi, os, json, re, threading, base64
import urllib.request, urllib.parse, html as htmlmod
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2, GLib

HTML = "file:///usr/share/receitas/index.html"
DATA = os.path.expanduser("~/.local/share/caderno-mae")
os.makedirs(DATA, exist_ok=True)

# ───────────── IA com VISÃO (mesma config do Assistente Guatá) ─────────────
import urllib.error
IA_CFG = os.path.expanduser("~/.config/guata/ia.json")
IA_PRESETS = {
    "claude":     {"tipo": "claude", "base": "https://api.anthropic.com/v1",                      "modelo": "claude-sonnet-5"},
    "openai":     {"tipo": "openai", "base": "https://api.openai.com/v1",                          "modelo": "gpt-4o-mini"},
    "gemini":     {"tipo": "openai", "base": "https://generativelanguage.googleapis.com/v1beta/openai", "modelo": "gemini-2.0-flash"},
    "openrouter": {"tipo": "openai", "base": "https://openrouter.ai/api/v1",                       "modelo": "openai/gpt-4o-mini"},
    "groq":       {"tipo": "openai", "base": "https://api.groq.com/openai/v1",                     "modelo": "llama-3.3-70b-versatile"},
    "local":      {"tipo": "openai", "base": "http://localhost:11434/v1",                          "modelo": "llava"},
    "outro":      {"tipo": "openai", "base": "",                                                   "modelo": ""},
}

def ia_perfil():
    try:
        with open(IA_CFG) as f: cfg = json.load(f)
    except Exception:
        cfg = {}
    prov = cfg.get("provedor", "claude")
    preset = IA_PRESETS.get(prov, IA_PRESETS["claude"])
    p = cfg.get("perfis", {}).get(prov, {})
    return {"tipo": preset["tipo"],
            "base": (p.get("base") or preset["base"]).rstrip("/"),
            "modelo": p.get("modelo") or preset["modelo"],
            "api_key": p.get("api_key", "")}

def ia_visao(perfil, prompt, img_b64, mime):
    """Manda imagem + texto pro modelo com visão. Retorna (texto, erro)."""
    try:
        if perfil["tipo"] == "claude":
            conteudo = [{"type": "text", "text": prompt},
                        {"type": "image", "source": {"type": "base64", "media_type": mime, "data": img_b64}}]
            corpo = json.dumps({"model": (perfil["modelo"] if not perfil["modelo"].startswith("gemini-1.5") else "gemini-2.0-flash"), "max_tokens": 1200,
                                "messages": [{"role": "user", "content": conteudo}]}).encode()
            req = urllib.request.Request(perfil["base"] + "/messages", data=corpo, method="POST")
            req.add_header("x-api-key", perfil["api_key"]); req.add_header("anthropic-version", "2023-06-01")
            req.add_header("content-type", "application/json")
            with urllib.request.urlopen(req, timeout=90) as r:
                d = json.loads(r.read().decode())
            return ("".join(b.get("text", "") for b in d.get("content", []) if b.get("type") == "text").strip(), None)
        else:
            conteudo = [{"type": "text", "text": prompt},
                        {"type": "image_url", "image_url": {"url": f"data:{mime};base64,{img_b64}"}}]
            corpo = json.dumps({"model": (perfil["modelo"] if not perfil["modelo"].startswith("gemini-1.5") else "gemini-2.0-flash"), "max_tokens": 1200,
                                "messages": [{"role": "user", "content": conteudo}]}).encode()
            req = urllib.request.Request((("https://generativelanguage.googleapis.com/v1beta/openai" if "generativelanguage.googleapis.com" in perfil["base"] and not perfil["base"].rstrip("/").endswith("/openai") else perfil["base"].rstrip("/")) + "/chat/completions"), data=corpo, method="POST")
            req.add_header("content-type", "application/json")
            if perfil["api_key"]: req.add_header("Authorization", "Bearer " + perfil["api_key"])
            with urllib.request.urlopen(req, timeout=90) as r:
                d = json.loads(r.read().decode())
            return (d["choices"][0]["message"]["content"].strip(), None)
    except urllib.error.HTTPError as e:
        if e.code in (401, 403): return (None, "Chave de API inválida. Configure no Assistente Guatá.")
        return (None, f"Erro da API ({e.code}).")
    except urllib.error.URLError:
        return (None, "Sem conexão com o provedor de IA.")
    except Exception as e:
        return (None, f"Falha: {e}")

def ia_json(txt):
    try:
        i = txt.index("{"); j = txt.rindex("}") + 1
        return json.loads(txt[i:j])
    except Exception:
        return None
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/122.0 Safari/537.36")

# ───────────────────────── busca / extração ─────────────────────────
def _get(url, timeout=12):
    req = urllib.request.Request(url, headers={
        "User-Agent": UA, "Accept-Language": "pt-BR,pt;q=0.9,en;q=0.6"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        cs = r.headers.get_content_charset() or "utf-8"
        return r.read().decode(cs, "replace")

def _clean(s):
    s = re.sub(r"<[^>]+>", "", str(s))
    s = htmlmod.unescape(htmlmod.unescape(s))  # trata entidades duplo-codificadas
    return re.sub(r"\s+", " ", s).strip()

def _iso_tempo(iso):
    m = re.match(r"PT(?:(\d+)H)?(?:(\d+)M)?", str(iso or ""))
    if not m:
        return ""
    h, mi = m.group(1), m.group(2)
    out = []
    if h:  out.append(f"{h} h")
    if mi: out.append(f"{mi} min")
    return " ".join(out)

def _iter(data):
    if isinstance(data, list):
        for x in data:
            yield from _iter(x)
    elif isinstance(data, dict):
        yield data
        if "@graph" in data:
            yield from _iter(data["@graph"])

def _normalizar(o):
    name = _clean(o.get("name", ""))
    img = o.get("image")
    if isinstance(img, dict): img = img.get("url")
    if isinstance(img, list) and img:
        img = img[0].get("url") if isinstance(img[0], dict) else img[0]
    ings = o.get("recipeIngredient") or o.get("ingredients") or []
    if isinstance(ings, str): ings = [ings]
    ings = [_clean(i) for i in ings if _clean(i)]
    steps = []
    ins = o.get("recipeInstructions") or []
    if isinstance(ins, str):
        steps = [_clean(x) for x in re.split(r"\r?\n|\.(?=\s+[A-ZÀ-Ú0-9])", ins) if _clean(x)]
    else:
        for s in ins:
            if isinstance(s, dict):
                if str(s.get("@type", "")).lower() == "howtosection":
                    for s2 in s.get("itemListElement", []):
                        if isinstance(s2, dict): steps.append(_clean(s2.get("text", "")))
                else:
                    steps.append(_clean(s.get("text") or s.get("name") or ""))
            else:
                steps.append(_clean(s))
    steps = [s for s in steps if s]
    tempo = _iso_tempo(o.get("totalTime") or o.get("cookTime") or "")
    if not (name and ings and steps):
        return None
    return {"titulo": name, "tempo": tempo, "ingredientes": ings,
            "passos": steps, "imagem_url": img}

def _recipe_da_pagina(page):
    for m in re.finditer(r'<script[^>]+application/ld\+json[^>]*>(.*?)</script>',
                         page, re.DOTALL | re.IGNORECASE):
        raw = m.group(1).strip()
        try:
            data = json.loads(raw)
        except Exception:
            continue
        for obj in _iter(data):
            t = obj.get("@type")
            types = t if isinstance(t, list) else [t]
            if any(str(x).lower() == "recipe" for x in types):
                r = _normalizar(obj)
                if r:
                    return r
    return None

def _buscar_links(query):
    q = urllib.parse.quote(query + " receita")
    try:
        sr = _get(f"https://html.duckduckgo.com/html/?q={q}")
    except Exception:
        return []
    urls = []
    for l in re.findall(r'<a[^>]+class="result__a"[^>]+href="([^"]+)"', sr):
        m = re.search(r"uddg=([^&]+)", l)
        u = urllib.parse.unquote(m.group(1)) if m else l
        if u.startswith("http") and "duckduckgo.com" not in u:
            urls.append(u)
    return urls

def _baixar_img(url):
    if not url:
        return None
    try:
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=12) as r:
            data = r.read()
            if len(data) > 3_500_000:
                return None
            ct = r.headers.get_content_type() or "image/jpeg"
            return f"data:{ct};base64," + base64.b64encode(data).decode()
    except Exception:
        return None

def buscar_receita(query):
    for u in _buscar_links(query)[:6]:
        try:
            page = _get(u)
        except Exception:
            continue
        rec = _recipe_da_pagina(page)
        if rec:
            rec["fonte"] = u
            rec["foto"] = _baixar_img(rec.get("imagem_url"))
            return rec
    return None

# ───────────────────────── app ─────────────────────────
class App:
    def __init__(self):
        self.win = Gtk.Window(title="O Caderno da Mãe")
        self.win.set_default_size(1000, 760)
        try:
            self.win.set_icon_from_file("/usr/share/icons/guata/receitas-icone-256.png")
        except Exception:
            pass
        try:
            dm = WebKit2.WebsiteDataManager(
                base_data_directory=DATA,
                base_cache_directory=os.path.join(DATA, "cache"))
            ctx = WebKit2.WebContext.new_with_website_data_manager(dm)
        except Exception:
            ctx = WebKit2.WebContext.get_default()
        self.ucm = WebKit2.UserContentManager()
        self.ucm.register_script_message_handler("buscar")
        self.ucm.connect("script-message-received::buscar", self.on_buscar)
        self.ucm.register_script_message_handler("foto_receita")
        self.ucm.connect("script-message-received::foto_receita", self.on_foto_receita)
        self.wv = WebKit2.WebView(web_context=ctx, user_content_manager=self.ucm)
        s = self.wv.get_settings()
        s.set_property("enable-developer-extras", False)
        self.wv.load_uri(HTML)
        self.win.add(self.wv)
        self.win.connect("destroy", Gtk.main_quit)
        self.win.show_all()

    def on_buscar(self, ucm, val):
        try:
            q = val.to_string()
        except AttributeError:
            q = val.get_js_value().to_string()
        threading.Thread(target=self._buscar_bg, args=(q,), daemon=True).start()

    def _buscar_bg(self, q):
        try:
            rec = buscar_receita(q)
        except Exception as e:
            rec = {"erro": str(e)}
        js = "window.receberBusca(%s)" % json.dumps(rec, ensure_ascii=False)
        GLib.idle_add(self._js, js)

    # ---- foto → receita (IA com visão) ----
    def on_foto_receita(self, ucm, val):
        try:
            modo = val.to_string()
        except AttributeError:
            modo = val.get_js_value().to_string()
        modo = modo or "prato"
        perfil = ia_perfil()
        if not perfil["api_key"] and "localhost" not in perfil["base"]:
            self._js("window.receberFoto(%s)" % json.dumps(
                {"erro": "Configure a IA primeiro: app Assistente Guatá → engrenagem → provedor + chave."}))
            return
        titulo = ("Escolha a foto da receita manuscrita" if modo == "manuscrito"
                  else "Escolha a foto do prato ou dos ingredientes")
        dlg = Gtk.FileChooserDialog(title=titulo, parent=self.win, action=Gtk.FileChooserAction.OPEN)
        dlg.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        dlg.add_button("Usar esta foto", Gtk.ResponseType.OK)
        flt = Gtk.FileFilter(); flt.set_name("Imagens")
        flt.add_mime_type("image/jpeg"); flt.add_mime_type("image/png"); flt.add_mime_type("image/webp")
        dlg.add_filter(flt)
        path = dlg.get_filename() if dlg.run() == Gtk.ResponseType.OK else None
        dlg.destroy()
        if not path:
            return
        self._js("window.fotoProcessando && window.fotoProcessando()")
        threading.Thread(target=self._foto_bg, args=(path, perfil, modo), daemon=True).start()

    def _foto_bg(self, path, perfil, modo="prato"):
        try:
            with open(path, "rb") as f:
                dados = f.read()
            ext = os.path.splitext(path)[1].lower()
            mime = {".png": "image/png", ".webp": "image/webp"}.get(ext, "image/jpeg")
            b64 = base64.b64encode(dados).decode()
            if modo == "manuscrito":
                prompt = ("Esta é a foto de uma RECEITA ESCRITA À MÃO (manuscrita, de um caderno "
                          "ou cartão de família). Transcreva fielmente o que está escrito, "
                          "mantendo as quantidades e medidas EXATAMENTE como na receita. "
                          "Responda SOMENTE um JSON válido, sem texto fora dele, no formato: "
                          '{"nome":"...","tempo":"ex.: 40 minutos","ingredientes":["..."],"passos":["..."]}. '
                          "Nos passos, quando houver um tempo, comece o passo com 'X min' "
                          "(ex.: '20 min no forno'). Em português do Brasil. Se algo estiver ilegível, "
                          "escreva [ilegível] no lugar — não invente.")
            else:
                prompt = ("Esta é a foto de um prato de comida (ou dos ingredientes). "
                          "Identifique e monte uma receita caseira brasileira para fazer isso. "
                          "Responda SOMENTE um JSON válido, sem texto fora dele, no formato: "
                          '{"nome":"...","tempo":"ex.: 40 minutos","ingredientes":["..."],"passos":["..."]}. '
                          "Nos passos, quando houver um tempo, comece o passo com 'X min' "
                          "(ex.: '20 min no forno a 180°') para virar cronômetro. "
                          "Ingredientes e passos são listas de frases curtas, em português do Brasil.")
            texto, erro = ia_visao(perfil, prompt, b64, mime)
            if erro:
                rec = {"erro": erro}
            else:
                data = ia_json(texto or "")
                if not data:
                    rec = {"erro": "Não consegui ler a receita da foto. Tente outra imagem."}
                else:
                    rec = {
                        "nome": data.get("nome", ""),
                        "tempo": data.get("tempo", ""),
                        "ingredientes": data.get("ingredientes", []),
                        "passos": data.get("passos", []),
                        "foto": f"data:{mime};base64,{b64}",
                    }
        except Exception as e:
            rec = {"erro": str(e)}
        self._js("window.receberFoto(%s)" % json.dumps(rec, ensure_ascii=False))
        return

    def _js(self, js):
        try:
            self.wv.run_javascript(js, None, None, None)
        except Exception:
            pass
        return False

if __name__ == "__main__":
    App()
    Gtk.main()
