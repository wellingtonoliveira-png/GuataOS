#!/bin/sh
# Guatá: live-build chama 'rsvg' (antigo); trixie só tem 'rsvg-convert'. Wrapper compat.
set -e
if [ ! -e /usr/bin/rsvg ] && command -v rsvg-convert >/dev/null 2>&1; then
cat > /usr/bin/rsvg <<'W'
#!/bin/sh
fmt=png; h=; w=; pos=""
while [ $# -gt 0 ]; do
  case "$1" in
    --format) fmt="$2"; shift 2;;
    --height) h="$2"; shift 2;;
    --width)  w="$2"; shift 2;;
    *) pos="$pos \"$1\""; shift;;
  esac
done
eval set -- $pos
exec rsvg-convert -f "$fmt" ${h:+-h "$h"} ${w:+-w "$w"} -o "$2" "$1"
W
chmod +x /usr/bin/rsvg
fi
